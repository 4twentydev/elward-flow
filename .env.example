# Yorkstead Operations Environment Configuration
# Copy to .env.local for local development. NEVER commit .env.local or real secrets.

# Application
NEXT_PUBLIC_APP_NAME=Yorkstead Operations
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elward_flow_dev

# Authentication (Better Auth)
BETTER_AUTH_SECRET=synthetic_local_dev_secret_32_characters_long_min
BETTER_AUTH_URL=http://localhost:3000
